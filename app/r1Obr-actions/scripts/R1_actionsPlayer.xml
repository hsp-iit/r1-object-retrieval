      <name>yarpActionsPlayer</name>
      <parameters>--filename actionsPlayer_R1SN003.ini --execute</parameters>
      <workdir>$ENV{ROBOT_CODE}/r1-object-retrieval/app/r1Obr-actions/conf/</workdir>
      <node>console</node>
   </module>

</application>
