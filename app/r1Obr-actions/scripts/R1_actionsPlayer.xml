<application>
   <name>R1_actionsPlayer</name>

   <dependencies>
   </dependencies>

   <!-- Plays the predefined actions (dances, navigation pose, ...) of R1SN003.
        yarpActionsPlayer opens the action files relative to its working directory. -->
